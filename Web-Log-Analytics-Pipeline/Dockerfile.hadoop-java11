# Dockerfile.hadoop-java11 — Apache Hadoop 3.3.6 on OpenJDK 11 LTS
# Project #53: Batch MapReduce Clickstream Log Analysis
#
# Base: apache/hadoop:3.3.6 (official Apache Hadoop release)
# Java: Eclipse Temurin OpenJDK 11 (Linux x64)
# Preserves Hadoop 3.3.6 binaries, /opt/starter.sh entrypoint, and hadoop user (1000:100).

FROM apache/hadoop:3.3.6

USER root

ARG JDK11_URL=https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.26+4/OpenJDK11U-jdk_x64_linux_hotspot_11.0.26_4.tar.gz

RUN mkdir -p /usr/lib/jvm/java-11 && \
    curl -LSs "${JDK11_URL}" | tar -xz -C /usr/lib/jvm/java-11 --strip-components=1 && \
    ln -sfn /usr/lib/jvm/java-11/bin/java /usr/bin/java && \
    ln -sfn /usr/lib/jvm/java-11/bin/javac /usr/bin/javac

ENV JAVA_HOME=/usr/lib/jvm/java-11
ENV PATH=/usr/lib/jvm/java-11/bin:${PATH}

USER hadoop
WORKDIR /opt/hadoop
