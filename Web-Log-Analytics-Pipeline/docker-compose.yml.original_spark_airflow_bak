# docker-compose.yml  —  Spark-Based Web Log Processing Pipeline
#
# Image versions:
#   HDFS:     bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
#   Spark:    apache/spark:3.5.6  (official image — bitnami/spark:3.2.1 removed from Hub)
#   Airflow:  apache/airflow:3.3.1  (built via Dockerfile.airflow)
#   Jupyter:  jupyter/pyspark-notebook:spark-3.5.0
#   Postgres: postgres:13
#
# Airflow 3 topology:
#   airflow-init          one-shot: db migrate + spark_default connection setup
#   airflow-apiserver     REST API + UI  (replaces the AF2 webserver)
#   airflow-scheduler     schedules and executes tasks (LocalExecutor)
#   airflow-dag-processor mandatory in AF3; parses DAG files separately from scheduler
#
# Host → container port map:
#   19870:9870  HDFS NameNode UI  (9870 reserved by Hyper-V on Windows; remapped to 19870)
#   7077:7077   Spark master RPC
#   8080:8080   Spark master UI
#   8085:8080   Airflow API Server UI  (avoids conflict with Spark's 8080)
#   8888:8888   Jupyter Notebook
#   4055:4040   Spark driver UI from Jupyter
#
# spark_default Airflow connection (created in airflow-init):
#   conn_type=spark  host=spark-master  port=7077

services:

  # ── HDFS ──────────────────────────────────────────────────────────────────
  hdfs-namenode:
    image: bde2020/hadoop-namenode:2.0.0-hadoop3.2.1-java8
    container_name: hdfs-namenode
    environment:
      - CLUSTER_NAME=hadoop-cluster
      - CORE_CONF_fs_defaultFS=hdfs://hdfs-namenode:9000
    ports:
      - "19870:9870"   # host 19870 → container 9870 (9870 excluded by Hyper-V)
    volumes:
      - hdfs-nn-data:/hadoop/dfs/name
      - ./spark-apps:/opt/spark-apps
    networks:
      - hadoopnet
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:9870"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  hdfs-datanode:
    image: bde2020/hadoop-datanode:2.0.0-hadoop3.2.1-java8
    container_name: hdfs-datanode
    depends_on:
      hdfs-namenode:
        condition: service_healthy
    environment:
      - CLUSTER_NAME=hadoop-cluster
      - CORE_CONF_fs_defaultFS=hdfs://hdfs-namenode:9000
      - HDFS_CONF_dfs_replication=1
    volumes:
      - hdfs-dn-data:/hadoop/dfs/data
    networks:
      - hadoopnet

  # ── Spark ──────────────────────────────────────────────────────────────────
  # apache/spark:3.5.6 official image — requires explicit spark-class commands
  # (unlike Bitnami which auto-detected the role from environment variables).
  spark-master:
    image: apache/spark:3.5.6
    container_name: spark-master
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.master.Master"]
    user: root
    environment:
      - SPARK_LOCAL_IP=spark-master
      - SPARK_MASTER_HOST=spark-master
    ports:
      - "7077:7077"
      - "8080:8080"
    volumes:
      - ./spark-apps:/opt/spark-apps
      - ./spark-events:/tmp/spark-events
      - ./output:/opt/spark-apps/output
    networks:
      - hadoopnet
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://spark-master:8080"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s

  spark-worker:
    image: apache/spark:3.5.6
    container_name: spark-worker
    command: ["/opt/spark/bin/spark-class", "org.apache.spark.deploy.worker.Worker", "spark://spark-master:7077"]
    user: root
    depends_on:
      spark-master:
        condition: service_healthy
    environment:
      - SPARK_LOCAL_IP=spark-worker
      - SPARK_WORKER_MEMORY=4g
      - SPARK_WORKER_CORES=2
    volumes:
      - ./spark-apps:/opt/spark-apps
      - ./output:/opt/spark-apps/output
    networks:
      - hadoopnet

  # ── Jupyter ────────────────────────────────────────────────────────────────
  jupyter:
    image: jupyter/pyspark-notebook:spark-3.5.0
    container_name: jupyter-notebook
    ports:
      - "8888:8888"
      - "4055:4040"
    volumes:
      - ./notebooks:/home/jovyan/work
      - ./spark-apps:/opt/spark-apps
    depends_on:
      spark-master:
        condition: service_healthy
    networks:
      - hadoopnet
    environment:
      - SPARK_OPTS=--conf spark.hadoop.fs.defaultFS=hdfs://hdfs-namenode:9000
    command: start-notebook.sh --NotebookApp.token='' --NotebookApp.password=''

  # ── Airflow DB ─────────────────────────────────────────────────────────────
  airflow-db:
    image: postgres:13
    container_name: airflow-db
    environment:
      - POSTGRES_USER=airflow
      - POSTGRES_PASSWORD=airflow
      - POSTGRES_DB=airflow
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - hadoopnet
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U airflow"]
      interval: 10s
      timeout: 5s
      retries: 5

  # ── Airflow Init (one-shot) ────────────────────────────────────────────────
  # Runs DB migration and creates the spark_default connection, then exits 0.
  airflow-init:
    build:
      context: .
      dockerfile: Dockerfile.airflow
    container_name: airflow-init
    restart: "no"
    depends_on:
      airflow-db:
        condition: service_healthy
    environment:
      - AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
      - AIRFLOW__CORE__EXECUTOR=LocalExecutor
      - AIRFLOW__CORE__LOAD_EXAMPLES=False
      - AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
      - AIRFLOW__API__SECRET_KEY=supersecretkey123
      - AIRFLOW__API_AUTH__JWT_SECRET=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_URL=http://airflow-apiserver:8080
      - AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution
    networks:
      - hadoopnet
    volumes:
      - ./dags:/opt/airflow/dags
    command: >
      bash -c "
        airflow db migrate &&
        airflow connections add spark_default
          --conn-type spark
          --conn-host spark-master
          --conn-port 7077
          2>/dev/null || true &&
        echo 'DB migration and connection setup complete.'
      "

  # ── Airflow API Server ─────────────────────────────────────────────────────
  # SimpleAuthManager auto-generates credentials on first init. Retrieve with:
  #   docker logs airflow-apiserver 2>&1 | grep "Password for user"
  airflow-apiserver:
    build:
      context: .
      dockerfile: Dockerfile.airflow
    container_name: airflow-apiserver
    restart: always
    depends_on:
      airflow-init:
        condition: service_completed_successfully
    environment:
      - AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
      - AIRFLOW__CORE__EXECUTOR=LocalExecutor
      - AIRFLOW__CORE__LOAD_EXAMPLES=False
      - AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
      - AIRFLOW__API__SECRET_KEY=supersecretkey123
      - AIRFLOW__API_AUTH__JWT_SECRET=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=supersecretkey123
      - AIRFLOW__WEBSERVER__EXPOSE_CONFIG=True
      - AIRFLOW__CORE__INTERNAL_API_URL=http://airflow-apiserver:8080
      - AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution
    ports:
      - "8085:8080"
    volumes:
      - ./dags:/opt/airflow/dags
      - ./spark-apps:/opt/spark-apps
      - ./output:/opt/spark-apps/output
      - ./hadoop-config/core-site.xml:/opt/hadoop/etc/hadoop/core-site.xml
    networks:
      - hadoopnet
    command: airflow api-server
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:8080/api/v2/health"]
      interval: 30s
      timeout: 10s
      retries: 10
      start_period: 60s

  # ── Airflow Scheduler ──────────────────────────────────────────────────────
  # In Airflow 3, the scheduler schedules tasks but does NOT parse DAG files.
  airflow-scheduler:
    build:
      context: .
      dockerfile: Dockerfile.airflow
    container_name: airflow-scheduler
    restart: always
    depends_on:
      airflow-init:
        condition: service_completed_successfully
    environment:
      - AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
      - AIRFLOW__CORE__EXECUTOR=LocalExecutor
      - AIRFLOW__CORE__LOAD_EXAMPLES=False
      - AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
      - AIRFLOW__API__SECRET_KEY=supersecretkey123
      - AIRFLOW__API_AUTH__JWT_SECRET=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_URL=http://airflow-apiserver:8080
      - AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution
    volumes:
      - ./dags:/opt/airflow/dags
      - ./spark-apps:/opt/spark-apps
      - ./output:/opt/spark-apps/output
      - ./hadoop-config/core-site.xml:/opt/hadoop/etc/hadoop/core-site.xml
    networks:
      - hadoopnet
    command: airflow scheduler

  # ── Airflow DAG Processor ──────────────────────────────────────────────────
  # REQUIRED in Airflow 3: parses DAG files. The scheduler no longer does this.
  airflow-dag-processor:
    build:
      context: .
      dockerfile: Dockerfile.airflow
    container_name: airflow-dag-processor
    restart: always
    depends_on:
      airflow-init:
        condition: service_completed_successfully
    environment:
      - AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-db:5432/airflow
      - AIRFLOW__CORE__EXECUTOR=LocalExecutor
      - AIRFLOW__CORE__LOAD_EXAMPLES=False
      - AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=
      - AIRFLOW__API__SECRET_KEY=supersecretkey123
      - AIRFLOW__API_AUTH__JWT_SECRET=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=supersecretkey123
      - AIRFLOW__CORE__INTERNAL_API_URL=http://airflow-apiserver:8080
    volumes:
      - ./dags:/opt/airflow/dags
      - ./spark-apps:/opt/spark-apps
      - ./hadoop-config/core-site.xml:/opt/hadoop/etc/hadoop/core-site.xml
    networks:
      - hadoopnet
    command: airflow dag-processor

volumes:
  postgres_data:
  hdfs-nn-data:
  hdfs-dn-data:

networks:
  hadoopnet:
